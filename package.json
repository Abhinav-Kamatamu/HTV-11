{
  "name": "undertow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:verify-vitals": "tsx --env-file-if-exists=.env.local scripts/verify-vitals-sql.ts",
    "db:verify-silence": "tsx --env-file-if-exists=.env.local scripts/verify-silence-sql.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.30.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
