# Copy to .env.local (git-ignored). Share real values in the team chat, never in git.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/undertow   # local docker; Tiger Cloud URL for shared/prod
GEMINI_API_KEY=
GEMINI_MODEL=                     # set to the current Gemini multimodal model name
UPLOAD_DIR=./uploads
DEMO_MODE=true                    # shows the "Synthetic demo data" badge and the role switcher
