# Copy to .env.local (git-ignored). Share real values in the team chat, never in git.
# No inline "KEY=value # comment" lines below — Node's --env-file strips the trailing comment
# fine, but `docker run --env-file` does not, so it ends up as part of the value (DECISIONS.md
# 2026-10-17: this broke GEMINI_MODEL and DEMO_MODE on the live deploy for exactly this reason).
# Tiger Cloud connection string, shared in team chat. Never commit the real value.
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require
GEMINI_API_KEY=
# Set to the current Gemini multimodal model name.
GEMINI_MODEL=
UPLOAD_DIR=./uploads
# Shows the "Synthetic demo data" badge and the role switcher.
DEMO_MODE=true
# Account API key, for T-032 research/testing only, keep in .env.local.
VULTR_API_KEY=
