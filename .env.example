# Copy to .env.local (git-ignored). Share real values in the team chat, never in git.
# Tiger Cloud connection string, shared in team chat. Never commit the real value.
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require
GEMINI_API_KEY=
GEMINI_MODEL=                     # set to the current Gemini multimodal model name
UPLOAD_DIR=./uploads
DEMO_MODE=true                    # shows the "Synthetic demo data" badge and the role switcher
VULTR_API_KEY=                    # account API key, for T-032 research/testing only, keep in .env.local
